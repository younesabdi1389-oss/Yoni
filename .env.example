# اتصال Neon (از داشبورد Neon > Connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ورود شخصی
APP_USERNAME=admin
APP_PASSWORD=یک-رمز-طولانی-و-قوی

# یک رشته‌ی تصادفی طولانی (مثلاً خروجی: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

PORT=3000
